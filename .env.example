# Local: nenhuma variável é obrigatória. O primeiro acesso é criado no terminal.
APP_ENV=development
# DATA_DIR=/caminho/absoluto/para/dados
# Em produção: APP_ENV=production e SECRET_KEY aleatória de pelo menos 32 caracteres.
SECRET_KEY=
# URL pública HTTPS, sem barra no final, depois de publicar.
PUBLIC_BASE_URL=
# Opcional: domínios permitidos separados por vírgula, sem https://.
TRUSTED_HOSTS=
# Usadas apenas na PRIMEIRA inicialização em produção. Não redefinem contas existentes.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_WHATSAPP=
ADMIN_PASSWORD=
